---
services:
  sing-box:
    image: "{{ bifrost_singbox_image }}"
    container_name: "sing-box"
    command: "-D /var/lib/sing-box -C /etc/sing-box run"
    environment:
      - "TZ={{ timezone }}"
    volumes:
      - "{{ bifrost_root }}/sing-box:/etc/sing-box"
      - "sb_data:/var/lib/sing-box"
    ports:
      - "51820:51820/udp"
      - "50080:1080"
    cap_add:
      - NET_ADMIN
    sysctls:
      - "net.ipv4.ip_forward=1"
      - "net.ipv4.conf.all.src_valid_mark=1"
      - "net.ipv4.conf.all.rp_filter=0"
    devices:
      - "/dev/net/tun:/dev/net/tun"
    networks:
      - "{{ deploy_network }}"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "ping", "-I", "sb0", "-c1", "1.1.1.1"]
      start_period: 20s
      interval: 5m
      timeout: 5s
      retries: 5

  wg-easy:
    image: "{{ bifrost_wg_easy_image }}"
    container_name: "wg-easy"
    environment:
      - "TZ={{ timezone }}"
      - "DISABLE_IPV6=true"
      - "INIT_ENABLED=true"
      - "INIT_USERNAME=admin"
      - "INIT_PASSWORD={{ bifrost_wg_password }}"
      - "INIT_HOST={{ bifrost_wg_endpoint }}"
      - "INIT_PORT=51820"
      - "INIT_DNS=1.1.1.1,8.8.8.8"
      - "INIT_IPV4_CIDR={{ bifrost_wg_ipv4_cidr }}"
      - "INIT_IPV6_CIDR={{ bifrost_wg_ipv6_cidr }}"
      - "INIT_WG_POST_UP=/opt/wg-easy/wg-hooks.sh up"
      - "INIT_WG_POST_DOWN=/opt/wg-easy/wg-hooks.sh down"
    volumes:
      - "/lib/modules:/lib/modules:ro"
      - "{{ bifrost_root }}/wg-easy:/etc/wireguard"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    depends_on:
      sing-box:
        condition: service_healthy
        restart: true
    network_mode: "service:sing-box"
    restart: unless-stopped

volumes:
  sb_data:

networks:
  {{ deploy_network }}:
    external: true
