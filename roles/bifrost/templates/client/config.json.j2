{
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "strategy": "ipv4_only",
        "cache_capacity": 4096,
        "servers": [
            {
                "type": "local",
                "tag": "local"
            },
            {
                "type": "udp",
                "server": "77.88.8.8",
                "tag": "yandex"
            },
            {
                "type": "udp",
                "server": "1.1.1.1",
                "tag": "cloudflare"
            }
        ]
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "mtu": 1400,
            "interface_name": "sb0",
            "address": "172.30.0.1/30",
            "auto_route": false,
            "strict_route": false,
            "sniff": true
        }
    ],
    "outbounds": [
        {
            "type": "vless",
            "tag": "vless-out",
            "server": "{{ bifrost_server }}",
            "server_port": 443,
            "uuid": "{{ bifrost_vless_uuid }}",
            "flow": "xtls-rprx-vision",
            "tls": {
                "enabled": true,
                "server_name": "{{ bifrost_vless_server_name }}",
                "reality": {
                    "enabled": true,
                    "public_key": "{{ bifrost_reality_public_key }}",
                    "short_id": "{{ bifrost_reality_short_id }}"
                },
                "utls": { "enabled": true, "fingerprint": "chrome" }
            }
        },
        {
            "type": "direct",
            "tag": "direct"
        },
        {
            "type": "block",
            "tag": "block"
        }
    ],
    "route": {
        "auto_detect_interface": true,
        "default_domain_resolver": "local",
        "rules": [
            {
                "action": "sniff",
                "timeout": "1s"
            },
            {
                "action": "hijack-dns",
                "protocol": "dns"
            },
            {
                "ip_is_private": true,
                "outbound": "direct"
            },
            {
                "domain_suffix": [
                    ".ru",
                    ".su",
                    ".ru.com",
                    ".ru.net"
                ],
                "outbound": "direct"
            },
            {
                "domain_keyword": [
                    "xn--"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "yandex",
                    "vk",
                    "mailru",
                    "ozon",
                    "wildberries"
                ],
                "outbound": "direct"
            },
            {
                "rule_set": [
                    "geoip-ru"
                ],
                "outbound": "direct"
            }
        ],
        "rule_set": [
            {
                "tag": "geoip-ru",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geoip/raw/rule-set/geoip-ru.srs",
                "update_interval": "7d"
            },
            {
                "tag": "yandex",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-yandex.srs",
                "update_interval": "7d"
            },
            {
                "tag": "vk",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-vk.srs",
                "update_interval": "7d"
            },
            {
                "tag": "mailru",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-mailru.srs",
                "update_interval": "7d"
            },
            {
                "tag": "ozon",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-ozon.srs",
                "update_interval": "7d"
            },
            {
                "tag": "wildberries",
                "type": "remote",
                "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-wildberries.srs",
                "update_interval": "7d"
            }
        ],
        "final": "vless-out"
    },
    "experimental": {
        "cache_file": {
           "enabled": true
        }
    }
}
